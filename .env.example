# Blast Radius — copy to .env and fill in.
#
#   cp .env.example .env
#
# docker compose reads this file from the repo root, and so does the
# provisioning script. Everything here has a working local default except the
# secrets, which have none on purpose.
#
# ONE THING TO GET RIGHT: MCP_AUTH_TOKEN is a shared secret with two readers.
# The MCP server checks it on every request; the TrueForge connector sends it
# as an Authorization header, written at `make provision` time from this same
# variable. Change it in one place only and every tool call returns 401.

# --- MCP server (packages/mcp-subject-data) --------------------------------

# Postgres holding the live and shadow schemas. The value below is the compose
# service; from your laptop it is @localhost instead of @postgres.
DATABASE_URL=postgres://blastradius:blastradius@postgres:5432/subject_data

# Bearer token the MCP server requires on every request. Required, no default.
# Generate one: openssl rand -hex 32
MCP_AUTH_TOKEN=replace-me-with-a-random-token

# Port the MCP server listens on. Default 8080.
MCP_PORT=8080

# Schema holding real data. Never written except by the approved deletion.
LIVE_SCHEMA=public

# Throwaway schema the rehearsal runs against. Safe to drop and rebuild.
SHADOW_SCHEMA=shadow

# Ceiling on any single statement, so a bad plan cannot run forever.
STATEMENT_TIMEOUT_MS=30000

# Ceiling on waiting for a row lock, so the gated write fails instead of hanging.
LOCK_TIMEOUT_MS=5000

# --- TrueForge harness (packages/agent) ------------------------------------

# Base URL of the TrueForge API the provisioning script talks to. Required.
TRUEFORGE_BASE_URL=http://localhost:3000

# Bearer token for that API. Optional — omit if your harness needs no auth.
TRUEFORGE_API_KEY=

# Fully-qualified model, `provider/model`. Required; substituted into
# agent.manifest.json in place of the __MODEL_NAME__ placeholder.
MODEL_NAME=openai/gpt-5.2

# Where the *harness* reaches the MCP server. This is a container DNS name when
# TrueForge runs in the same compose network, and http://localhost:8080/mcp
# only when it runs on your host. Default http://mcp-server:8080/mcp.
MCP_SERVER_URL=http://mcp-server:8080/mcp

# Name the agent is created/updated under. Default blast-radius.
AGENT_NAME=blast-radius
