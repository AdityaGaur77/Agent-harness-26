# Postgres connection used by the MCP server. Inside compose, host = postgres.
DATABASE_URL=postgresql://blast:blast@localhost:5432/blast_main
SHADOW_DB_NAME=blast_shadow

# Shared secret for the MCP server. The TrueForge connector and smoke tests send it as a bearer token.
MCP_AUTH_TOKEN=change-me-dev-token

# Public URL for the MCP server (used by Vercel UI). For Fly: https://blast-mcp.fly.dev/mcp
MCP_URL=http://localhost:8080/mcp

# Optional server-side Exa proxy used by the Vercel UI. Never expose this in browser code.
EXA_API_KEY=
# The browser's MCP bearer token authenticates the proxy. Set this separately when
# the Vercel function does not share MCP_AUTH_TOKEN.
EXA_PROXY_TOKEN=
# Optional comma-separated origin allowlist for cross-origin UI deployments.
EXA_ALLOWED_ORIGINS=
# Shared production counter for the Exa proxy (Upstash Redis REST credentials).
# Required on Vercel; local development uses a process-local fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Port the MCP server listens on.
PORT=8080
UI_ORIGIN=http://localhost:4173
MCP_HOST_PORT=8080
DEMO_MCP_HOST_PORT=8081

# --- provisioning (packages/agent) ---
# TrueForge hosted mode runs on 8791 (compose), local mode on 8790.
TRUEFORGE_BASE_URL=http://localhost:8791
TRUEFORGE_TOKEN=
MODEL_NAME=
# Containerized TrueForge reaches the synthetic demo MCP endpoint through the host.
MCP_SERVER_URL=http://host.docker.internal:8081/mcp

# Optional comma-separated free-model fallback list used when MODEL_NAME is empty.
# TrueForge owns provider authentication and runtime retries; this repo does not
# attempt to rotate provider keys inside the provisioning script.
MODEL_NAMES=unorouter/gpt-oss-120b:free,unorouter/glm-5.3-flash:free
